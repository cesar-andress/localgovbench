{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_affordance_matrix_v1.schema.json",
  "title": "Schema affordance matrix row v1",
  "description": "One finalized schema_object × disclosure_function affordance judgment. No realization fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_object_id",
    "source_name",
    "disclosure_function_id",
    "support_level",
    "applicability_label",
    "encoding_type",
    "documentary_linkage_layer",
    "coder_confidence",
    "adjudication_status",
    "specification_version",
    "coding_version",
    "corpus_lock_sha256",
    "experiment_id",
    "pipeline_version"
  ],
  "properties": {
    "schema_object_id": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string", "minLength": 1 },
    "schema_object_type": { "type": "string" },
    "disclosure_function_id": { "type": "string", "minLength": 1 },
    "support_level": { "type": "string", "enum": ["dedicated", "indirect", "absent"] },
    "applicability_label": { "type": "string" },
    "encoding_type": { "type": "string" },
    "documentary_linkage_layer": { "type": "string" },
    "function_specific_link_type": { "type": ["string", "null"] },
    "coder_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "adjudication_status": { "type": "string" },
    "adjudicated_from": { "type": "string" },
    "coding_round_id": { "type": "string" },
    "specification_version": { "type": "string", "const": "1.0.0" },
    "coding_version": { "type": "string", "const": "1.0.0" },
    "corpus_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schema_inventory_version": { "type": "string" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 }
  }
}
